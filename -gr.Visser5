// Bol Processor BP3
// Data saved as "-gr.Visser5". Date: 2026-11-26 12:09:22

// -gr.Visser5 by Harm Visser (April 1998)
// Play it in Csound or SuperCollider
-se.Visser5
-tb.onebeat
-cs.Beethoven-fugue-b-flat-major
-sc.Beethoven-fugue-b-flat-major


// This grammar was rewritten in November 2026 for the current convention of serial tools, producing exactly the same work.
// The composer's _rotate instructions were processed by the old algorithm, in which parameters such as _transpose() or _keyxpand() and periods kept their positions while notes, silences and {} expressions moved. A rotation applied to the rest of its field, including every nested expression, adding up with the rotations inside it.
// Their results are spelled out by the variables named "...rotateMinusN" (rotation by -N), with the original rules in comments.

ORD
_mm(60.0000) _striated
gram#1[1] S --> _ins(violin) _vel(80) _rndvel(20) {Melos1 Melos2 Melos3}
gram#1[2] Melos1 --> {Mel1 Mel2 Mel3}
gram#1[3] Melos2 --> _transpose(11) {Melos1}
gram#1[4] Melos3 --> _transpose(5) {Melos1 - Melos2}


--------------

ORD


// Mel1 was {M1 - - - - - . M2 - - M3 M4 - - M5}, with M3 --> _transpose(-6) _rotate(-2) {{M1 M2}, {_keyxpand(C3,-1) M1}}, which rotated "M3 M4 - - M5"

gram#2[1] Mel1 --> {M1 - - - - - . M2 - - _transpose(-6) M5rotateMinus2 M3rotateMinus2 M4rotateMinus2 - -}
gram#2[2] Mel2 --> _transpose(-11) {Mel1}


// Mel3 was _transpose(6) _rotate(-1) {Mel1 - Mel2}

gram#2[3] Mel3 --> _transpose(6) {{Mel1rotateMinus1} Mel1rotateMinus1 _transpose(-11) -}
gram#2[4] Mel1rotateMinus1 --> {- M5rotateMinus3 M3rotateMinus3 M4rotateMinus3 - M1rotateMinus1 - - - - . - M2rotateMinus1 - _transpose(-6) -}


--------------

ORD
gram#3[1] M1 --> {C3 - . D4 F#3 _keyxpand(B3,-1) C3 - D3 F#2}
gram#3[2] M2 --> {_transpose(2) {M1}}


// The original rules M3, M4 and M5, now spelled out as rotated variants:
// M3 --> _transpose(-6) _rotate(-2) {{M1 M2}, {_keyxpand(C3,-1) M1}}
// M4 --> {C3 D4 F#3 _keyxpand(B3,-1) C3 D3 F#2}
// M5 --> {_keyxpand(B4,-1){M4, _vel(100) M1}} {M2, M3}
// XrotateMinusN was {_rotate(-N) X}. In M5rotateMinusN, M3 is rotated by -(N+2) because of its own _rotate(-2).

gram#3[3] M1rotateMinus1 --> {F#2 C3 . - D4 _keyxpand(B3,-1) F#3 C3 - D3}
gram#3[4] M1rotateMinus2 --> {D3 F#2 . C3 - _keyxpand(B3,-1) D4 F#3 C3 -}
gram#3[5] M1rotateMinus3 --> {- D3 . F#2 C3 _keyxpand(B3,-1) - D4 F#3 C3}
gram#3[6] M1rotateMinus4 --> {C3 - . D3 F#2 _keyxpand(B3,-1) C3 - D4 F#3}
gram#3[7] M1rotateMinus5 --> {F#3 C3 . - D3 _keyxpand(B3,-1) F#2 C3 - D4}
gram#3[8] M4rotateMinus2 --> {D3 F#2 C3 _keyxpand(B3,-1) D4 F#3 C3}
gram#3[9] M4rotateMinus3 --> {C3 D3 F#2 _keyxpand(B3,-1) C3 D4 F#3}
gram#3[10] M2rotateMinus1 --> {_transpose(2) {M1rotateMinus1}}
gram#3[11] M2rotateMinus2 --> {_transpose(2) {M1rotateMinus2}}
gram#3[12] M2rotateMinus3 --> {_transpose(2) {M1rotateMinus3}}
gram#3[13] M2rotateMinus4 --> {_transpose(2) {M1rotateMinus4}}
gram#3[14] M2rotateMinus5 --> {_transpose(2) {M1rotateMinus5}}
gram#3[15] M3rotateMinus2 --> {{M1rotateMinus2 M2rotateMinus2}, {_keyxpand(C3,-1) M1rotateMinus2}}
gram#3[16] M3rotateMinus3 --> {{M2rotateMinus3 M1rotateMinus3}, {_keyxpand(C3,-1) M1rotateMinus3}}
gram#3[17] M3rotateMinus4 --> {{M1rotateMinus4 M2rotateMinus4}, {_keyxpand(C3,-1) M1rotateMinus4}}
gram#3[18] M3rotateMinus5 --> {{M2rotateMinus5 M1rotateMinus5}, {_keyxpand(C3,-1) M1rotateMinus5}}
gram#3[19] M5rotateMinus2 --> {_keyxpand(B4,-1){M4rotateMinus2, _vel(100) M1rotateMinus2}} {M2rotateMinus2, _transpose(-6) M3rotateMinus4}
gram#3[20] M5rotateMinus3 --> {_keyxpand(B4,-1){M4rotateMinus3, _vel(100) M1rotateMinus3}} {M2rotateMinus3, _transpose(-6) M3rotateMinus5}


------

COMMENT:
This is a very compact grammar producing a musical piece (about 10 minutes) which takes advantage of BP2's serial tools. (Bernard Bel)