-se.trySerialTools

// This is temporary set of examples using serial tools:
// "_retro", "_rndseq", "_randomize", "_rotate", "_ordseq", "_keymap" and "_keyxpand".

// Only visual results are significant. No need to listen to sound rendering! To save time, select the "Event list" output format.

// Since the seed for randomisation is set to a positive number, random productions should remain unchanged when restarting productions.

// More information: https://bolprocessor.org/serial-tools/

-al.abc1
-to.tryTunings
-cs.tryTunings

// First, we check tools that modify the order in a sequence

[The _retro tool] 
_retro C0 C2

_retro {C0 C2}

_retro A3 B3 C3 1/4 D3

[Propagate in polymetric structure] 
_retro {A4 B4, C4 D4 E4}

_retro {a b {c d, C4 D4}} 1/4

_retro {a b {3, c d, C4 D4}}

[Cascading _retro] 
_retro {a b _retro {c d _retro {A4 B4}}}

[Less intuitive] 
_retro a b _retro c d _retro A4 B4

{_retro {_retro {C0 C2}}} C1

[Ordering a sequence] 
{ A3, C5 _ordseq C4} F4

[Combined with _retro] 
_retro a b c d _ordseq A5 B5 C5

_retro {A3 B3, C5 D5 _ordseq C4 D4} F4

[Randomising the order. Note that _rndseq will always produce the same order because seed = 1] 
_rndseq a b c d

[Here, the order will change because to the _randomize command] 
_randomize _rndseq a b c d

[No effect] 
_randomize a b c d

[_randomize is misplaced, as it will be contained in the sequence] 
_rndseq _randomize a b c d

[The second part is not randomised] 
_rndseq a b c d _ordseq A5 B5 C5

[Several random sequences. Which ones are equivalent?] 
_rndseq{A4 B4 C4} _rndseq{A5 B5 C5 D5}

_rndseq A4 B4 C4 _rndseq A5 B5 C5 D5

_rndseq A4 B4 C4 {_rndseq A5 B5 C5 D5}

[Rotate] 
_rotate(2) C4 D4 E4 F4

_rotate(-1) C4 D4 E4 F4

_rotate(2) C4 D4 E4 1 2 F4

[This one was incorrect with version 3.5.1, as _rotate was ignoring the ',' field separator] 
_rotate(1) {A4 B4 _rotate(1) C4 F4 G4, A3 B3 C3}

[This one was also wrong in version 3.5.1] 
_rotate(0) A4 B4 C4

[Rotate all fields in polymetric structures] 
_rotate(-1) {a b {c d, C4 D4 E4}}

_rotate(-1) {3, D4 E4}

_rotate(-1) C4 {3, D4 E4} F4

_rotate(-1) {C4 {D4 E4} F4} {C3 {3, D3 E3} F3}

[Rotate after retro] 
_rotate(2) _retro C4 D4 E4 F4

[Amounts to _rotate(0) because -1 + 2 - 1 = 0] 
_rotate(-1) {_rotate(2) _rotate(-1) a b c d}

[Two expressions] 
{_rotate(-1) a b c d} {_rotate(2) a b c d} C4

[With two prolongations of "a"] 
_rotate(-1) {a__ b c d}

[Tempo markers take part in the rotation] 
_rotate(-1) C4 D4 _tempo(3/2) E4 F4 G4

[Idem but we can't predict where the _tempo() will land] 
_rndseq {C4 D4 _tempo(1.5) E4 F4}

[Idem] 
_rndseq {C4 D4 /4 E4 F4 G4 A4}

[Several fields] 
_rotate(-1) {A4 B4 C4 D4, A2 B2 C2}

_rotate(-1) { A2 B2 C2, A3 B3 C3, A4 B4 C4} F4 G4

[With silent sound-object] 
_rotate(-1) {a b c d, c' b d}

[With silence and silent sound-objects] 
_rotate(-1) {- b a c d, a b c'} d'

[Sound-object "a" moves to the left due to its continuity property] 
_rotate(-1) {- a b c d, a b c'}

[This one is not easy to understand!] 
_rotate(2) {A4 B4 _rotate(-1) C4 {D4 E4} F4, A3 B3 C3} F5 G5

[Several fields with different rotations] 
_rotate(-1) {_rotate(2) a' b c d, a' b c, C5 D5 E5 F5 G5}

[Change rotation inside a field] 
{A4 B4 _rotate(-1) C4 D4}

_rotate(1) {A4 B4 _rotate(-2) C4 D4 E4 F4}

_rotate(2) A4 B4 _rotate(-1) C4 D4 E4 F4

{_rotate(2) A4 B4 _rotate(-1) C4 D4 E4 F4, A3 B3 C3}

{_rotate(2) a' b _rotate(-1) c d A5 B5, a' b c, _retro C4 D4 _ordseq E4 F4 G4}

{_rotate(2) _rotate(-1) a' b c d, {a' b c, F3 G3 A3}, _rotate(0) C4 D4 E4}

[Effect of rotate is invisible because of _rndseq] 
_rotate(-2) {_rndseq {a b c d}}

{_rndseq _rotate(1) {C4 D4 E4 F4}} C3 D3 E3 F3

{_rndseq _retro {C4 D4 E4 F4}} C3 D3 E3 F3